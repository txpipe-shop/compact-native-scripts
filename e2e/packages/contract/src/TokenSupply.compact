pragma language_version 0.23.0;

import CompactStandardLibrary;
import "Warden" prefix Warden_;

/// LEDGER ///

/**
 * @description Token domain separator, used to derive the token colour via tokenType().
 * Sealed — immutable after construction.
 */
export sealed ledger domain: Bytes<32>;

/**
 * @description Maximum token supply — set once in the constructor and never changes.
 */
export sealed ledger cap: Uint<64>;

/**
 * @description Tokens minted so far. Increases on mint, decreases on burn.
 */
export ledger currentSupply: Uint<64>;

/**
 * @description Mint counter used to derive unique nonces for each minted shielded coin.
 */
ledger mintCounter: Counter;

/**
 * @description Mint counter used to derive unique nonces for each minted shielded coin.
 */
ledger mintNonce: Bytes<32>;

/// CONSTRUCTOR ///

/**
 * @description Initialises the contract: calls Warden_init() to bootstrap the
 * access-control commitments, then stores the fixed supply cap and token domain.
 * @param {Uint<64>} maxSupply - The hard cap on total mintable tokens.
 * @param {Bytes<32>} domain - Domain separator for this token.
 * @param {Bytes<32>} initNonce - Initial nonce to use for deriving coins.
 */
constructor(maxSupply: Uint<64>, tokenDomain: Bytes<32>, initNonce: Bytes<32>) {
  Warden_init();
  cap = disclose(maxSupply);
  currentSupply = 0;
  mintNonce = disclose(initNonce);
  domain = disclose(tokenDomain);
}

/// CIRCUITS ///

/**
 * @description Convenience passthrough to Warden.commit(). Registers the
 * caller's commitment on-ledger so they satisfy the access-control policy.
 */
export circuit commit(): [] {
  Warden_commit();
}

/**
 * @description Mints a new shielded token. Only succeeds if the Warden
 * access-control policy is satisfied and the cap is not exceeded.
 *
 * Evolves the nonce seed to guarantee each minted coin has a unique nonce,
 * preventing nullifier collisions.
 *
 * @param {Uint<64>} amount - Number of tokens to mint.
 * @param {ZswapCoinPublicKey} recipient - Who receives the minted shielded coin.
 * @return {ShieldedCoinInfo} The newly minted coin's info (needed to prove future spends).
 */
export circuit mint(amount: Uint<64>,
                    recipient: ZswapCoinPublicKey
                    ): ShieldedCoinInfo {
  Warden_verify();
  assert((currentSupply + amount) as Uint<64> <= cap,
         "TokenSupply: exceeds cap");
  assert(amount > 0, "TokenSupply: attempting to mint non-positive value");
  currentSupply = disclose((currentSupply + amount) as Uint<64>);
  mintNonce = evolveNonce(mintCounter, mintNonce);
  mintCounter.increment(1);
  return mintShieldedToken(
    disclose(domain),
    disclose(amount),
    disclose(mintNonce),
    disclose(left<ZswapCoinPublicKey, ContractAddress>(recipient))
  );
}

/**
 * @description Burns a shielded token by receiving it (which consumes the UTXO
 * at the ledger level), then decreases currentSupply.
 *
 * @param {ShieldedCoinInfo} coin - The shielded coin to burn.
 */
export circuit burn(coin: ShieldedCoinInfo): [] {
  Warden_verify();
  const color = tokenType(domain, kernel.self());
  assert(coin.color == color, "TokenSupply: color does not match");
  assert(coin.value > 0, "TokenSupply: attempting to burn non-positive value");
  assert(coin.value <= (currentSupply as Uint<128>), "TokenSupply: underflow");
  receiveShielded(disclose(coin));
  // TO-DO: send to burnAddress
  currentSupply = disclose((currentSupply - coin.value) as Uint<64>);
}
