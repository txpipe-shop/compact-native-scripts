// Compact Native Script Contract (access/Warden.compact)

pragma language_version 0.23.0;

/**
 * @module Warden
 * @description A contract library.
 * Provides a mechanism to grant access to a circuit based on a set of commitments.
 */
module Warden {
  import CompactStandardLibrary;

  /**
   * @description Store the IDs to which each committment has to be added.
   * @key commitment hash
   * @value set of IDs
   */
  export ledger commitmentsToIds: Map<Bytes<32>, Set<Bytes<8>>>;

  /**
   * @description Store commitments.
   * @key hash id of the set
   * @value set of commitments
   */
  export ledger idsToCommitments: Map<Bytes<8>, Set<Bytes<32>>>;

  /**
   * @description Witness function to fetch a secret from the wallet.
   * This secret will be used to obtain the commitment.
   */
  witness localSecret(): Bytes<32>;

  /**
   * @description Witness function to fetch the randomness that along with a secret
   * generates a specific commitment.
   */
  witness randomness(): Bytes<32>;

  /**
   * @description Generates the commitment that will be added into the idsToCommitments ledger.
   */
  export pure circuit getCommitment(secret: Bytes<32>, randomness: Bytes<32>): Bytes<32> {
    return persistentCommit<Bytes<32>>(secret, randomness);
  }

  /**
   * @description Initialize state. Constructors are not available within
   * modules, so this circuit has to be called from the overall program's
   * top level constructor.
   */
  export circuit init(): [] {
    assert(commitmentsToIds.isEmpty(), "Init circuit has already been called");
    commitmentsToIds.insertDefault(Bytes[33, 243, 20, 227, 103, 145, 101, 242, 52, 254, 138, 152, 111, 96, 210, 160, 48, 142, 75, 132, 100, 21, 254, 104, 244, 191, 157, 61, 25, 78, 167, 76]);
    commitmentsToIds.lookup(Bytes[33, 243, 20, 227, 103, 145, 101, 242, 52, 254, 138, 152, 111, 96, 210, 160, 48, 142, 75, 132, 100, 21, 254, 104, 244, 191, 157, 61, 25, 78, 167, 76]).insert(Bytes[48, 32, 32, 32, 32, 32, 32, 32]);
    commitmentsToIds.insertDefault(Bytes[149, 23, 220, 185, 134, 218, 24, 9, 150, 136, 232, 139, 111, 225, 252, 229, 104, 253, 14, 235, 125, 219, 186, 134, 168, 38, 61, 196, 137, 248, 87, 131]);
    commitmentsToIds.lookup(Bytes[149, 23, 220, 185, 134, 218, 24, 9, 150, 136, 232, 139, 111, 225, 252, 229, 104, 253, 14, 235, 125, 219, 186, 134, 168, 38, 61, 196, 137, 248, 87, 131]).insert(Bytes[48, 32, 32, 32, 32, 32, 32, 32]);
    commitmentsToIds.insertDefault(Bytes[218, 109, 66, 193, 31, 92, 165, 54, 244, 19, 73, 125, 142, 142, 189, 62, 100, 215, 139, 221, 128, 226, 31, 88, 121, 83, 125, 126, 169, 75, 21, 131]);
    commitmentsToIds.lookup(Bytes[218, 109, 66, 193, 31, 92, 165, 54, 244, 19, 73, 125, 142, 142, 189, 62, 100, 215, 139, 221, 128, 226, 31, 88, 121, 83, 125, 126, 169, 75, 21, 131]).insert(Bytes[48, 32, 32, 32, 32, 32, 32, 32]);
    commitmentsToIds.insertDefault(Bytes[198, 76, 201, 146, 98, 49, 12, 55, 45, 178, 133, 197, 209, 115, 161, 204, 248, 216, 30, 229, 113, 207, 106, 170, 33, 165, 94, 110, 46, 53, 195, 82]);
    commitmentsToIds.lookup(Bytes[198, 76, 201, 146, 98, 49, 12, 55, 45, 178, 133, 197, 209, 115, 161, 204, 248, 216, 30, 229, 113, 207, 106, 170, 33, 165, 94, 110, 46, 53, 195, 82]).insert(Bytes[48, 32, 32, 32, 32, 32, 32, 32]);
    commitmentsToIds.lookup(Bytes[198, 76, 201, 146, 98, 49, 12, 55, 45, 178, 133, 197, 209, 115, 161, 204, 248, 216, 30, 229, 113, 207, 106, 170, 33, 165, 94, 110, 46, 53, 195, 82]).insert(Bytes[48, 95, 52, 32, 32, 32, 32, 32]);
    commitmentsToIds.insertDefault(Bytes[46, 157, 1, 151, 153, 180, 217, 59, 241, 204, 104, 200, 17, 156, 21, 76, 196, 231, 248, 20, 116, 63, 34, 1, 182, 183, 248, 168, 137, 123, 79, 225]);
    commitmentsToIds.lookup(Bytes[46, 157, 1, 151, 153, 180, 217, 59, 241, 204, 104, 200, 17, 156, 21, 76, 196, 231, 248, 20, 116, 63, 34, 1, 182, 183, 248, 168, 137, 123, 79, 225]).insert(Bytes[48, 95, 52, 32, 32, 32, 32, 32]);
    commitmentsToIds.insertDefault(Bytes[35, 83, 31, 51, 195, 185, 251, 121, 10, 64, 204, 45, 211, 26, 27, 197, 98, 163, 226, 20, 186, 132, 61, 3, 224, 230, 19, 241, 243, 176, 127, 217]);
    commitmentsToIds.lookup(Bytes[35, 83, 31, 51, 195, 185, 251, 121, 10, 64, 204, 45, 211, 26, 27, 197, 98, 163, 226, 20, 186, 132, 61, 3, 224, 230, 19, 241, 243, 176, 127, 217]).insert(Bytes[48, 95, 52, 32, 32, 32, 32, 32]);
    idsToCommitments.insertDefault(Bytes[48, 32, 32, 32, 32, 32, 32, 32]);
    idsToCommitments.insertDefault(Bytes[48, 95, 52, 32, 32, 32, 32, 32]);
  }

  /**
   * @description Add a commitment if it is authorized (member of
   * commitmentsToIds).
   */
  export circuit commit(): [] {
    assert(!commitmentsToIds.isEmpty(), "Cannot commit to uninitialized contract");
    const commitment = getCommitment(localSecret(), randomness());
    assert(commitmentsToIds.member(commitment), "This key is not authorized to commit in this contract");
    assert(!commitmentsToIds.lookup(commitment).isEmpty(), "Commitment ID set is empty");
    assert(!idsToCommitments.lookup(Bytes[48, 32, 32, 32, 32, 32, 32, 32]).member(commitment), "This commitment has already been registered");
    if (commitmentsToIds.lookup(commitment).member(Bytes[48, 32, 32, 32, 32, 32, 32, 32])) { idsToCommitments.lookup(Bytes[48, 32, 32, 32, 32, 32, 32, 32]).insert(commitment); }
    assert(!idsToCommitments.lookup(Bytes[48, 95, 52, 32, 32, 32, 32, 32]).member(commitment), "This commitment has already been registered");
    if (commitmentsToIds.lookup(commitment).member(Bytes[48, 95, 52, 32, 32, 32, 32, 32])) { idsToCommitments.lookup(Bytes[48, 95, 52, 32, 32, 32, 32, 32]).insert(commitment); }
  }

  /**
   * @description Checks that the commitments currently present satisfy the
   * predefined conditions.
   *
   * @notice this is the access-control entry point that the application
   * has to call before execution.
   */
  export circuit verify(): [] {
    const id_0_4 = idsToCommitments.lookup(Bytes[48, 95, 52, 32, 32, 32, 32, 32]).member(Bytes[46, 157, 1, 151, 153, 180, 217, 59, 241, 204, 104, 200, 17, 156, 21, 76, 196, 231, 248, 20, 116, 63, 34, 1, 182, 183, 248, 168, 137, 123, 79, 225]) && idsToCommitments.lookup(Bytes[48, 95, 52, 32, 32, 32, 32, 32]).member(Bytes[198, 76, 201, 146, 98, 49, 12, 55, 45, 178, 133, 197, 209, 115, 161, 204, 248, 216, 30, 229, 113, 207, 106, 170, 33, 165, 94, 110, 46, 53, 195, 82]) && idsToCommitments.lookup(Bytes[48, 95, 52, 32, 32, 32, 32, 32]).member(Bytes[35, 83, 31, 51, 195, 185, 251, 121, 10, 64, 204, 45, 211, 26, 27, 197, 98, 163, 226, 20, 186, 132, 61, 3, 224, 230, 19, 241, 243, 176, 127, 217]);
    const id_0 = idsToCommitments.lookup(Bytes[48, 32, 32, 32, 32, 32, 32, 32]).member(Bytes[33, 243, 20, 227, 103, 145, 101, 242, 52, 254, 138, 152, 111, 96, 210, 160, 48, 142, 75, 132, 100, 21, 254, 104, 244, 191, 157, 61, 25, 78, 167, 76]) || idsToCommitments.lookup(Bytes[48, 32, 32, 32, 32, 32, 32, 32]).member(Bytes[149, 23, 220, 185, 134, 218, 24, 9, 150, 136, 232, 139, 111, 225, 252, 229, 104, 253, 14, 235, 125, 219, 186, 134, 168, 38, 61, 196, 137, 248, 87, 131]) || idsToCommitments.lookup(Bytes[48, 32, 32, 32, 32, 32, 32, 32]).member(Bytes[218, 109, 66, 193, 31, 92, 165, 54, 244, 19, 73, 125, 142, 142, 189, 62, 100, 215, 139, 221, 128, 226, 31, 88, 121, 83, 125, 126, 169, 75, 21, 131]) || idsToCommitments.lookup(Bytes[48, 32, 32, 32, 32, 32, 32, 32]).member(Bytes[198, 76, 201, 146, 98, 49, 12, 55, 45, 178, 133, 197, 209, 115, 161, 204, 248, 216, 30, 229, 113, 207, 106, 170, 33, 165, 94, 110, 46, 53, 195, 82]) || id_0_4;
    assert(id_0, "Commitments or time-lock conditions not satisfied");
    idsToCommitments.lookup(Bytes[48, 32, 32, 32, 32, 32, 32, 32]).resetToDefault();
    idsToCommitments.lookup(Bytes[48, 95, 52, 32, 32, 32, 32, 32]).resetToDefault();
  }
}


