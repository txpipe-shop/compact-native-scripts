{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "@e2e/wallet#build": {
      "outputs": ["dist/**"]
    },
    "@e2e/contract#build": {
      "dependsOn": ["@e2e/wallet#build"],
      "outputs": ["dist/**"]
    },
    "@e2e/api#build": {
      "dependsOn": ["@e2e/contract#build"],
      "outputs": ["dist/**"]
    }
  }
}
